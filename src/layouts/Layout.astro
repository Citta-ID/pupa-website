---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AccessibilityToolbar from '../components/AccessibilityToolbar.astro';
import { routes, useTranslations, type Lang } from '../i18n/ui';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  routeKey: string;      // key into the routes map, powers hreflang + language toggle
  altUrls?: { en: string; id: string; ko: string };  // per-page overrides (article translations)
  title: string;
  description: string;
  ogImage?: string;        // site-relative path, e.g. an article's own photo
  ogType?: 'website' | 'article';
  publishedTime?: string;  // ISO date, articles only
  jsonLd?: object;         // extra structured data (e.g. Article)
  noindex?: boolean;
}
const { lang, routeKey, title, description, altUrls, ogImage, ogType = 'website', publishedTime, jsonLd, noindex } = Astro.props;
const ogImageUrl = (Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.pupacenter.org') + (ogImage ?? '/images/brand/og-image.jpg');
const t = useTranslations(lang);
const route = altUrls ?? (routes[routeKey] ?? routes.home);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.pupacenter.org';

// First-visit language gateway: only on the EN homepage ('/'). Respects a stored
// explicit choice, otherwise routes by browser language. Runtime path guard keeps
// this inert if the markup is ever served at another URL (e.g. a CDN 404 fallback).
const isHomeGateway = Astro.url.pathname === '/';
const langRedirectScript = `(function(){try{
if(location.pathname!=='/')return;
var s=localStorage.getItem('pupa-lang');
if(s==='id'){location.replace('/id/');return}
if(s==='ko'){location.replace('/ko/');return}
if(s)return;
var l=((navigator.languages&&navigator.languages[0])||navigator.language||'').toLowerCase();
if(l==='id'||l.indexOf('id-')===0||l==='in'||l.indexOf('in-')===0){location.replace('/id/')}
else if(l==='ko'||l.indexOf('ko-')===0){location.replace('/ko/')}
}catch(e){}})();`;
// Hides a photo that fails to load and lets its card show a placeholder instead
// (replaces inline onerror="…" attributes, which a strict security policy blocks).
const imgFallbackScript = `document.addEventListener('error',function(e){var t=e.target;if(t&&t.tagName==='IMG'&&t.hasAttribute('data-fallback')){t.style.display='none';if(t.parentElement)t.parentElement.classList.add('no-photo')}},true);`;
const revealHeadScript = `(function(){try{var d=document.documentElement,m=false;
try{m=!!JSON.parse(localStorage.getItem('pupa-a11y')||'{}').motion}catch(e){}
if(m){d.setAttribute('data-a11y-motion','on');return}
if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
d.classList.add('reveal')}catch(e){}})();`;
// Anything already on screen (or scrolled past) appears instantly; the rest
// fades in once as it enters. The huge top margin means jumping past an element
// (End key, anchor link) still counts as 'entered', so nothing is left hidden above.
// ~0.6 KB total, no library.
const revealBodyScript = `(function(){var d=document.documentElement;if(!d.classList.contains('reveal'))return;
var els=[].slice.call(document.querySelectorAll('[data-reveal]')),h=innerHeight;
var io=new IntersectionObserver(function(es){es.forEach(function(e){
if(e.isIntersecting||e.boundingClientRect.top<0){e.target.classList.add('is-in');if(!e.isIntersecting)e.target.classList.add('no-anim');io.unobserve(e.target)}})},
{rootMargin:'9999px 0px -8% 0px'});
els.forEach(function(el){if(el.getBoundingClientRect().top<h*0.92){el.classList.add('is-in','no-anim')}else io.observe(el)});})();`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {isHomeGateway && <script is:inline set:html={langRedirectScript} />}
  <script is:inline set:html={revealHeadScript} />
  <script is:inline set:html={imgFallbackScript} />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={site + route[lang]} />
  <link rel="alternate" hreflang="en" href={site + route.en} />
  <link rel="alternate" hreflang="id" href={site + route.id} />
  <link rel="alternate" hreflang="ko" href={site + route.ko} />
  <link rel="alternate" hreflang="x-default" href={site + route.en} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta property="og:url" content={site + route[lang]} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#00534B" />
  <meta property="og:locale" content={lang === 'id' ? 'id_ID' : lang === 'ko' ? 'ko_KR' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'en' ? 'id_ID' : 'en_US'} />
  <meta property="og:site_name" content="PUPA Center" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'PUPA Center',
    alternateName: 'Yayasan PUPA Center',
    url: 'https://www.pupacenter.org',
    logo: 'https://www.pupacenter.org/images/brand/pupa-logo.png',
    image: 'https://www.pupacenter.org/images/brand/og-image.jpg',
    description: lang === 'id'
      ? 'Pusat pengembangan kecakapan hidup dan kesiapan kerja bagi anak muda neurodivergen di Tangerang, Indonesia.'
      : 'A development center for life skills and work readiness for neurodivergent young adults in Tangerang, Indonesia.',
    slogan: 'Transform to shine',
    foundingDate: '2015',
    email: 'info@pupacenter.org',
    telephone: '+62818533698',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Ruko The Prominence Blok 38E No. 42-43, Jl. Jalur Sutera, Alam Sutera',
      addressLocality: 'Tangerang',
      addressRegion: 'Banten',
      postalCode: '15143',
      addressCountry: 'ID',
    },
    geo: { '@type': 'GeoCoordinates', latitude: -6.2288, longitude: 106.6539 },
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'],
      opens: '08:30', closes: '16:30',
    },
    areaServed: { '@type': 'Place', name: 'Tangerang, Banten, Indonesia' },
    sameAs: [
      'https://www.instagram.com/pupa.center',
      'https://www.youtube.com/@PUPACenter',
    ],
  })} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip-link" href="#main">{t('a11y.skip')}</a>
  <Header lang={lang} routeKey={routeKey} altRoute={altUrls} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <AccessibilityToolbar lang={lang} />
  <script is:inline set:html={revealBodyScript} />
</body>
</html>
