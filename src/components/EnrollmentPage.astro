---
import { waLink } from '../utils/whatsapp';
import Layout from '../layouts/Layout.astro';
import { routes, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const p = (key: string) => (routes[key] ?? routes.home)[lang];
const wa = waLink(lang, 'enrollment');

const content = {
  en: {
    metaTitle: 'Enrollment — How to Join PUPA Center',
    metaDescription: 'How to join PUPA Center, for neurodivergent young adults aged 16–25: get in touch, an introduction session, a visit, registration, a 1–3 month probation period, and the decision.',
    h1: 'Enrollment',
    intro: 'Our enrollment process is designed to ensure the right fit for every participant. Through an initial introduction and assessment period, we take time to understand individual needs, goals, and readiness before placement into our programs. Registration is open year-round.',
    stepsTitle: 'The Enrollment Process',
    steps: [
      ['Get to know us', 'Message us on WhatsApp at +62 818 533 698. We reply on WhatsApp within 1 working day. Young people aged 16–25 can also contact us themselves. So can psychologists, therapists and teachers who would like to refer someone.'],
      ['Introduction session', 'We introduce PUPA through a video or an online meeting. Ask us anything.'],
      ['Visit', 'Parents or guardians and the young person visit PUPA at a time we agree together. Before the visit, we send a short form (2 minutes) so the first visit feels comfortable. You do not need to bring any documents yet.'],
      ['Registration', 'We send you a link to the registration form on WhatsApp. It takes about 12 minutes. You can fill it in bit by bit. The young person also fills in their own part, "Tentang Saya" (About me).'],
      ['Probation period (1–3 months)', 'Once all the documents are in, we confirm the start date. Before the first day, you fill in the "Siap Mulai" (Ready to start) form, about 3 minutes. About a month in, PUPA reviews how it is going. During this time there is one counseling session for parents.'],
      ['Decision', 'We meet you to talk through the evaluation. Ready to join: we send you an acceptance letter. Further preparation required: we send you a full report with advice on next steps.'],
    ],
    ctaStart: 'Message us on WhatsApp',
    ctaNote: 'We reply on WhatsApp within 1 working day.',
    prepTitle: 'What to prepare',
    prepIntro: 'For registration (step 4) and before the first day:',
    prep: [
      'The psychologist and IQ report from the last 2 years. A photo of each page or a PDF is enough. No report yet, or is it more than 2 years old? We will help you find a way.',
      'The young person’s full name, as on their birth certificate.',
      'School or therapist reports, if you have them. You can skip these.',
      'If the young person is 18 or older and a court has appointed a guardian, a copy of the court order.',
      'Health information for safety: allergies, seizures, medicines during PUPA hours, and the clinic your family prefers.',
      'Emergency contacts, and everyone who may collect the young person.',
    ],
    trust: 'Form links always come from PUPA’s WhatsApp, +62 818 533 698. They always start with https://family.pupacenter.org. Each link works for 30 days.',
    faqTitle: 'Frequently Asked Questions',
    faq: [
      ['What is PUPA Center?', 'PUPA Center is a development center focused on life skills and work readiness for neurodivergent individuals, particularly adolescents and young adults. The program is delivered through structured and practical programs.'],
      ['Is PUPA Center a school?', 'No. PUPA Center is a development and support center rather than a formal school. Our programs do not follow an academic school curriculum.'],
      ['Is PUPA Center a therapy center?', 'No. PUPA Center does not provide therapy services. Instead, we focus on developing life skills and independence for neurodivergent individuals through structured, supportive activities.'],
      ['Who can participate in PUPA Center programs?', 'Our programs are intended for neurodivergent adolescents and adults, including autistic people. Participation is determined through eligibility criteria and an initial assessment process.'],
      ['What programs are offered at PUPA Center?', 'PUPA Center offers programs including life skills development, work readiness skills, social and communication skills, functional activities, and practice-based learning experiences (experiential learning).'],
      ['What is the age requirement to enroll?', 'PUPA is for young people aged 16–25 at enrollment. Outside that age? We are still glad to talk.'],
      ['Can young people contact PUPA themselves?', 'Yes. If you are 16–25, you can message us on WhatsApp yourself at +62 818 533 698. If you are under 18, a parent or guardian gives consent. From 18, you give your own consent, with your family’s support, unless a court has appointed a guardian.', wa],
      ['Is there an assessment before joining?', 'Yes. At registration, we ask for a psychologist and IQ report from the last 2 years. No report yet, or is it more than 2 years old? We will help you find a way. During the 1–3 month probation period, we get to know the young person and find the program that suits them best.'],
      ['Can participants be accompanied by a shadow teacher?', 'During activities, PUPA Center supervisors support participants. Shadow teachers do not come into the activity room.'],
      ['Does PUPA Center offer job placement or internships?', 'PUPA Center offers programs that introduce participants to the world of work and provide practical experience, but employment placement is not guaranteed.'],
      ['How does communication with parents work?', 'For now, we keep in touch on WhatsApp. We send progress reports regularly. The PUPA family app is coming later. You can also talk things through with the PUPA Center team when needed.'],
      ['Are there activities outside of PUPA Center?', 'Yes. Participants may take part in outings, social activities, and experience-based projects, depending on the program and scheduled timeline.'],
      ['How can I enroll?', 'Message us on WhatsApp at +62 818 533 698. We reply within 1 working day.', wa],
      ['What is the activity schedule?', 'Activities take place five days a week, Monday through Friday, from 9:00 AM to 3:00 PM (WIB).'],
      ['Will participants get a job after completing a program?', 'PUPA Center does not guarantee job placement. However, our programs are designed to equip participants with work-related skills, work habits, and relevant practical experience as preparation for employment or other productive activities.'],
      ['My child is non-speaking. Can they take part?', 'PUPA Center is open to young people with a wide range of support needs, whether they speak or not. At registration, we ask how your young person communicates: speaking, signs or gestures, pictures or cards, a tablet or app, or writing. This helps their support staff understand them from the first day. Program fit is decided through the initial assessment.'],
      ['How are classes structured, considering the diversity of the autism spectrum?', 'To accommodate diverse needs, PUPA Center conducts a 1–3 month probation period during which assessments and observations are carried out. Participants are then grouped into classes based on similar developmental phases and learning paces.'],
      ['Can registration be done at any time?', 'Yes, registration is open year-round. PUPA Center organizes its programs into three terms each year. Participants who join between January and June may enter an ongoing program, with any missed content adjusted through an Individualized Education Plan (IEP). Participants who join between July and December will repeat the program package in the following year, as more than 50% of the program content has already been completed.'],
    ],
  },
  id: {
    metaTitle: 'Pendaftaran — Cara Bergabung dengan PUPA Center',
    metaDescription: 'Cara bergabung dengan PUPA Center untuk anak muda neurodivergen usia 16–25: kenalan, sesi perkenalan, kunjungan, pendaftaran, masa percobaan 1–3 bulan, lalu keputusan.',
    h1: 'Pendaftaran',
    intro: 'Proses pendaftaran kami dirancang untuk memastikan setiap peserta mendapatkan program yang paling sesuai. Melalui masa perkenalan dan asesmen awal, kami meluangkan waktu untuk memahami kebutuhan, tujuan, dan kesiapan setiap individu sebelum penempatan ke dalam program kami. Pendaftaran dibuka sepanjang tahun.',
    stepsTitle: 'Proses Pendaftaran',
    steps: [
      ['Kenalan', 'Kirim WhatsApp ke 0818-533-698. Kami balas lewat WhatsApp paling lambat 1 hari kerja. Anak muda usia 16–25 juga bisa menghubungi kami sendiri. Begitu juga psikolog, terapis, atau guru yang ingin merujuk.'],
      ['Sesi perkenalan', 'Kami kenalkan PUPA lewat video atau pertemuan online. Boleh tanya apa saja.'],
      ['Kunjungan', 'Orang tua/wali dan calon peserta datang ke PUPA sesuai jadwal yang disepakati. Sebelumnya kami kirim formulir singkat (2 menit) supaya kunjungan pertama terasa nyaman. Belum perlu membawa dokumen apa pun.'],
      ['Pendaftaran', 'Kami kirim link formulir pendaftaran lewat WhatsApp. Mengisinya sekitar 12 menit. Boleh diisi bertahap. Calon peserta juga mengisi bagiannya sendiri, "Tentang Saya".'],
      ['Masa percobaan (1–3 bulan)', 'Setelah semua dokumen lengkap, kami kabari tanggal mulainya. Sebelum hari pertama, isi formulir "Siap Mulai" (3 menit). Setelah sekitar 1 bulan, PUPA meninjau perkembangannya. Selama masa ini ada satu sesi konseling untuk orang tua.'],
      ['Keputusan', 'Kami bertemu Anda untuk membahas hasil evaluasi. Siap bergabung: kami kirim surat penerimaan. Diperlukan persiapan lebih lanjut: kami kirim laporan lengkap dan saran langkah berikutnya.'],
    ],
    ctaStart: 'Kirim WhatsApp',
    ctaNote: 'Kami balas lewat WhatsApp paling lambat 1 hari kerja.',
    prepTitle: 'Yang perlu disiapkan',
    prepIntro: 'Untuk pendaftaran (langkah 4) dan sebelum hari pertama:',
    prep: [
      'Hasil tes psikologi dan IQ dari 2 tahun terakhir. Foto setiap halaman atau PDF sudah cukup. Belum punya hasil tes, atau sudah lebih dari 2 tahun? Kami bantu cari jalannya.',
      'Nama lengkap calon peserta sesuai akta lahir.',
      'Laporan sekolah atau terapis, kalau ada. Boleh dilewati.',
      'Kalau calon peserta sudah 18 tahun dan ada penetapan pengadilan tentang perwalian, siapkan salinannya.',
      'Info kesehatan untuk keselamatan: alergi, kejang, obat selama jam PUPA, dan klinik pilihan keluarga.',
      'Kontak darurat dan siapa saja yang boleh menjemput.',
    ],
    trust: 'Link formulir selalu kami kirim dari WhatsApp PUPA 0818-533-698. Alamatnya selalu diawali https://family.pupacenter.org. Setiap link berlaku 30 hari.',
    faqTitle: 'Pertanyaan yang Sering Diajukan',
    faq: [
      ['Apa itu PUPA Center?', 'PUPA Center adalah pusat pengembangan keterampilan hidup dan kesiapan kerja bagi individu neurodivergen, khususnya remaja dan dewasa muda. Program pendampingan disampaikan secara terstruktur dan praktis. Peserta belajar lewat praktik, sesuai tahapnya.'],
      ['Apakah PUPA Center sebuah sekolah?', 'Bukan. PUPA Center adalah pusat pengembangan dan pendampingan (lembaga informal), bukan sekolah formal. Program-program kami tidak mengikuti kurikulum akademik sekolah, melainkan dirancang untuk mengembangkan keterampilan hidup dan kesiapan kerja secara praktis khusus bagi individu neurodivergen.'],
      ['Apakah PUPA Center pusat terapi?', 'Bukan. PUPA Center bukan tempat terapi. Kami fokus pada pengembangan keterampilan hidup dan kemandirian bagi individu neurodivergen melalui kegiatan yang terstruktur dan suportif.'],
      ['Siapa yang bisa mengikuti program PUPA Center?', 'Program PUPA Center ditujukan untuk remaja dan dewasa neurodivergen, termasuk individu autistik, sesuai dengan kriteria dan asesmen awal.'],
      ['Program apa saja yang tersedia di PUPA Center?', 'Program PUPA Center mencakup pengembangan kemandirian (keterampilan hidup), kesiapan kerja, keterampilan sosial dan komunikasi, aktivitas fungsional, serta pengalaman belajar berbasis praktik.'],
      ['Berapa usia yang dipersyaratkan untuk mendaftar?', 'PUPA untuk usia 16–25 tahun saat mendaftar. Usia di luar itu? Kami tetap senang berbicara.'],
      ['Apakah anak muda bisa menghubungi PUPA sendiri?', 'Bisa. Kamu yang berusia 16–25 tahun bisa kirim WhatsApp sendiri ke 0818-533-698. Kalau kamu belum 18 tahun, orang tua/wali yang memberi persetujuan. Sejak 18 tahun, kamu memberi persetujuanmu sendiri, didampingi keluarga, kecuali ada penetapan pengadilan tentang perwalian.', wa],
      ['Apakah ada asesmen sebelum bergabung?', 'Ya. Saat pendaftaran, kami meminta hasil tes psikologi dan IQ dari 2 tahun terakhir. Belum punya hasil tes, atau sudah lebih dari 2 tahun? Kami bantu cari jalannya. Selama masa percobaan 1–3 bulan, kami mengenal calon peserta lebih dekat dan mencari program yang paling sesuai.'],
      ['Apakah peserta bisa didampingi guru pendamping?', 'Selama kegiatan, peserta didampingi supervisor PUPA Center. Guru pendamping tidak ikut masuk ke ruang kegiatan.'],
      ['Apakah PUPA Center menyediakan penempatan kerja atau magang?', 'Magang kerja adalah bagian dari rangkaian program PUPA (Karya). PUPA Center menyediakan program pengenalan dunia kerja dan pengalaman praktik, namun bukan sebagai jaminan penempatan kerja.'],
      ['Bagaimana komunikasi dengan orang tua berlangsung?', 'Saat ini kami berkabar lewat WhatsApp. Laporan perkembangan kami kirim secara berkala. Aplikasi keluarga PUPA menyusul. Kalau perlu, Anda juga bisa berdiskusi dengan tim PUPA Center.'],
      ['Apakah ada kegiatan di luar PUPA Center?', 'Ya. PUPA mendorong peserta aktif dan mandiri berkegiatan di area publik. Outing, hangout, dan berbelanja adalah hal rutin yang dikembangkan dalam program kegiatan PUPA secara terstruktur, selaras dengan program.'],
      ['Bagaimana cara mendaftar?', 'Kirim WhatsApp ke 0818-533-698. Kami balas lewat WhatsApp paling lambat 1 hari kerja.', wa],
      ['Bagaimana jadwal kegiatan di PUPA Center?', 'Kegiatan dilaksanakan lima hari dalam seminggu, Senin–Jumat, pukul 09.00–15.00 WIB.'],
      ['Apakah peserta akan mendapat pekerjaan setelah menyelesaikan program?', 'PUPA Center tidak menjamin penempatan kerja. Namun, program PUPA Center dirancang untuk membekali peserta dengan keterampilan kerja, kebiasaan kerja, dan pengalaman praktik yang relevan sebagai persiapan menuju dunia kerja atau aktivitas produktif lainnya.'],
      ['Anak saya tidak berbicara. Apakah bisa ikut program?', 'PUPA Center terbuka untuk anak muda dengan berbagai kebutuhan dukungan, baik yang berbicara maupun yang tidak. Saat pendaftaran, kami bertanya bagaimana anak Anda berkomunikasi: berbicara, isyarat, gambar atau kartu, tablet atau aplikasi, atau menulis. Dengan begitu, pendamping bisa memahaminya sejak hari pertama. Kesesuaian program ditentukan lewat asesmen awal.'],
      ['Bagaimana struktur kelas, mengingat keberagaman spektrum autisme?', 'PUPA Center menerapkan masa percobaan selama 1–3 bulan. Pada periode ini, tim melakukan asesmen dan observasi untuk memahami profil, kebutuhan, serta pace berkegiatan peserta. Peserta akan bergabung pada kelompok yang selaras dengan kebutuhannya.'],
      ['Apakah pendaftaran bisa dilakukan kapan saja?', 'Ya, pendaftaran dibuka sepanjang tahun. PUPA Center membagi programnya menjadi tiga term setiap tahun. Peserta yang bergabung antara Januari–Juni bisa masuk ke program yang sedang berjalan, dengan materi yang terlewat disesuaikan melalui Individualized Education Plan (IEP). Peserta yang bergabung antara Juli–Desember akan mengulang paket program pada tahun berikutnya, karena lebih dari 50% materi program telah selesai.'],
    ],
  },
  ko: {
    metaTitle: '입학 안내 — PUPA 센터 등록 절차',
    metaDescription: '16–25세 신경다양성 청년을 위한 PUPA 센터 등록 절차: 첫 연락, 소개 세션, 방문, 등록, 1–3개월의 적응 기간, 그리고 결정.',
    h1: '입학 안내',
    intro: '우리의 등록 절차는 모든 참여자에게 맞는 자리를 찾기 위해 설계되었습니다. 첫 소개와 평가 기간을 통해, 프로그램 배치에 앞서 개인의 필요와 목표, 준비 정도를 충분히 이해하는 시간을 갖습니다. 등록은 연중 언제나 가능합니다.',
    stepsTitle: '등록 절차',
    steps: [
      ['첫 연락', 'WhatsApp(+62 818 533 698)으로 메시지를 보내 주세요. 영업일 기준 하루 안에 WhatsApp으로 답변드립니다. 16–25세 청년 본인도 직접 연락하실 수 있습니다. 의뢰를 원하시는 심리학자, 치료사, 교사도 연락하실 수 있습니다.'],
      ['소개 세션', '영상 또는 온라인 미팅으로 PUPA를 소개해 드립니다. 궁금한 점은 무엇이든 물어보세요.'],
      ['방문', '부모님(보호자)과 예비 참여자가 함께 정한 일정에 PUPA를 방문합니다. 첫 방문이 편안하도록 방문 전에 짧은 양식(2분)을 보내 드립니다. 이때는 서류를 가져오지 않으셔도 됩니다.'],
      ['등록', 'WhatsApp으로 등록 양식 링크를 보내 드립니다. 작성에는 약 12분이 걸리며, 여러 번에 나누어 작성하셔도 됩니다. 예비 참여자도 자신의 부분인 "Tentang Saya"(나에 대해)를 작성합니다. 양식은 인도네시아어와 영어로 제공됩니다.'],
      ['적응 기간 (1–3개월)', '서류가 모두 준비되면 시작 날짜를 알려 드립니다. 첫날 전에 "Siap Mulai"(시작 준비) 양식(약 3분)을 작성해 주세요. 약 한 달이 지나면 PUPA가 그간의 과정을 점검합니다. 이 기간에 부모 상담이 한 차례 있습니다.'],
      ['결정', 'PUPA 팀이 부모님과 만나 평가 결과를 함께 이야기합니다. 등록 준비 완료 시: 입학 안내문을 보내 드립니다. 추가 준비가 필요한 경우: 상세 보고서와 다음 단계에 대한 조언을 보내 드립니다.'],
    ],
    ctaStart: 'WhatsApp으로 문의하기',
    ctaNote: '영업일 기준 하루 안에 WhatsApp으로 답변드립니다. 문의는 영어 또는 인도네시아어로 부탁드립니다.',
    prepTitle: '준비할 것',
    prepIntro: '등록(4단계)과 첫날 전에 필요한 것:',
    prep: [
      '최근 2년 이내의 심리 평가 및 IQ 검사 결과. 각 페이지를 찍은 사진이나 PDF면 충분합니다. 검사 결과가 없거나 2년이 지났나요? 방법을 함께 찾아 드립니다.',
      '출생증명서에 적힌 예비 참여자의 전체 이름.',
      '학교나 치료사의 보고서(있는 경우). 건너뛰셔도 됩니다.',
      '예비 참여자가 18세 이상이고 법원이 후견인을 지정했다면, 그 결정문 사본.',
      '안전을 위한 건강 정보: 알레르기, 발작, PUPA 활동 시간 중 복용하는 약, 가족이 선호하는 병원.',
      '비상 연락처, 그리고 데리러 올 수 있는 모든 분.',
    ],
    trust: '양식 링크는 언제나 PUPA WhatsApp(+62 818 533 698)에서 보내 드립니다. 링크 주소는 항상 https://family.pupacenter.org 로 시작합니다. 각 링크는 30일 동안 유효합니다.',
    faqTitle: '자주 묻는 질문',
    faq: [
      ['PUPA 센터는 어떤 곳인가요?', 'PUPA 센터는 신경다양인, 특히 청소년과 청년의 생활 기술과 취업 준비에 집중하는 성장 지원 센터입니다. 체계적이고 실용적인 프로그램으로 운영됩니다.'],
      ['PUPA 센터는 학교인가요?', '아니요. PUPA 센터는 정규 학교가 아닌 성장 지원 센터입니다. 우리의 프로그램은 학교 교과 과정을 따르지 않습니다.'],
      ['PUPA 센터는 치료 센터인가요?', '아니요. PUPA 센터는 치료 서비스를 제공하지 않습니다. 대신 체계적이고 지지적인 활동을 통해 신경다양인의 생활 기술과 자립을 키우는 데 집중합니다.'],
      ['누가 PUPA 센터 프로그램에 참여할 수 있나요?', '자폐 스펙트럼을 포함한 신경다양성 청소년과 성인을 위한 프로그램입니다. 참여 여부는 자격 기준과 초기 평가 과정을 통해 결정됩니다.'],
      ['어떤 프로그램이 있나요?', 'PUPA 센터는 생활 기술 개발, 취업 준비 기술, 사회성과 의사소통 기술, 기능적 활동, 그리고 실습 기반 학습(체험 학습)을 포함한 프로그램을 제공합니다.'],
      ['등록 가능한 연령은 어떻게 되나요?', 'PUPA는 등록 시점에 16–25세인 청년을 위한 곳입니다. 연령이 이 범위 밖이라도 기꺼이 이야기 나누겠습니다.'],
      ['청년 본인이 직접 PUPA에 연락할 수 있나요?', '네. 16–25세라면 WhatsApp(+62 818 533 698)으로 직접 메시지를 보내셔도 됩니다. 18세 미만이라면 부모님이나 보호자가 동의합니다. 18세부터는 가족의 도움을 받으며 본인이 직접 동의합니다. 단, 법원이 후견인을 지정한 경우는 예외입니다.', wa],
      ['참여 전에 평가가 있나요?', '네. 등록할 때 최근 2년 이내의 심리 평가 및 IQ 검사 결과를 요청합니다. 검사 결과가 없거나 2년이 지났다면 방법을 함께 찾아 드립니다. 1–3개월의 적응 기간 동안 예비 참여자를 더 깊이 알아 가며 가장 알맞은 프로그램을 찾습니다.'],
      ['보조 교사(섀도 티처)가 동행할 수 있나요?', '활동 중에는 PUPA 센터 지도자들이 참여자를 지원합니다. 보조 교사는 활동실에 함께 들어오지 않습니다.'],
      ['취업 연계나 인턴십이 있나요?', 'PUPA 센터는 일의 세계를 소개하고 실무 경험을 제공하는 프로그램을 운영하지만, 취업 배치가 보장되지는 않습니다.'],
      ['부모와의 소통은 어떻게 이루어지나요?', '현재는 WhatsApp으로 소식을 전합니다. 성장 보고서는 정기적으로 보내 드립니다. PUPA 가족 앱은 추후 제공될 예정입니다. 필요하시면 PUPA 센터 팀과 상의하실 수도 있습니다.'],
      ['PUPA 센터 밖에서의 활동도 있나요?', '네. 프로그램과 일정에 따라 참여자들은 야외 활동, 사회 활동, 체험 기반 프로젝트에 참여할 수 있습니다.'],
      ['어떻게 등록하나요?', 'WhatsApp(+62 818 533 698)으로 메시지를 보내 주세요. 영업일 기준 하루 안에 답변드립니다. 문의는 영어 또는 인도네시아어로 부탁드립니다.', wa],
      ['활동 일정은 어떻게 되나요?', '활동은 주 5일, 월요일부터 금요일까지 오전 9시부터 오후 3시(WIB)까지 진행됩니다.'],
      ['프로그램을 마치면 취업이 되나요?', 'PUPA 센터는 취업을 보장하지 않습니다. 다만 우리의 프로그램은 취업 또는 그 밖의 생산적 활동을 준비할 수 있도록 업무 관련 기술과 업무 습관, 실질적 경험을 갖추게 설계되어 있습니다.'],
      ['우리 아이는 말을 하지 않습니다. 참여할 수 있나요?', 'PUPA 센터는 말을 하는 청년이든 하지 않는 청년이든, 다양한 지원 요구를 가진 청년에게 열려 있습니다. 등록할 때 자녀가 어떻게 소통하는지 여쭙니다. 말, 수어나 몸짓, 그림이나 카드, 태블릿이나 앱, 글쓰기 등입니다. 덕분에 지원 교사가 첫날부터 자녀를 이해할 수 있습니다. 프로그램 적합성은 초기 평가를 통해 결정합니다.'],
      ['자폐 스펙트럼의 다양성을 고려할 때 수업은 어떻게 구성되나요?', '다양한 필요를 반영하기 위해 PUPA 센터는 1–3개월의 적응 기간 동안 평가와 관찰을 진행합니다. 이후 발달 단계와 학습 속도가 비슷한 참여자들끼리 반을 구성합니다.'],
      ['아무 때나 등록할 수 있나요?', '네, 등록은 연중 열려 있습니다. PUPA 센터는 프로그램을 매년 세 학기로 운영합니다. 1월–6월에 합류하는 참여자는 진행 중인 프로그램에 들어가며, 놓친 내용은 개별화교육계획(IEP)으로 조정합니다. 7월–12월에 합류하는 참여자는 프로그램 내용의 50% 이상이 이미 진행되었기 때문에 이듬해에 해당 프로그램 과정을 다시 이수합니다.'],
    ],
  },
};
const c = content[lang] ?? content.en;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Layout lang={lang} routeKey="enrollment" title={c.metaTitle} description={c.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-head">
    <div class="wrap">
      <h1>{c.h1}</h1>
      <p class="lede">{c.intro}</p>
    </div>
  </section>

  <section class="steps" id="steps">
    <div class="wrap">
      <h2 class="steps-title">{c.stepsTitle}</h2>
      <div class="steps-grid">
        <div class="timeline">
          {c.steps.map((s, i) => (
            <details class="tl-step" open={i === 0}>
              <summary>
                <span class="tl-node" aria-hidden="true">{i + 1}</span>
                <span class="tl-title">{s[0]}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="tl-body"><p>{s[1]}</p></div>
            </details>
          ))}
          <div class="steps-ctas">
            <a class="btn btn-primary" href={wa} rel="noopener">{c.ctaStart}</a>
            <p class="steps-note">{c.ctaNote}</p>
          </div>
        </div>
        <div class="steps-photo">
          <img src="/images/enrollment.jpg" alt="A participant taking part in an activity at PUPA Center" loading="lazy" width="520" height="680" />
        </div>
      </div>
      <aside class="prep-box" aria-labelledby="prep-title">
        <h3 id="prep-title">{c.prepTitle}</h3>
        <p class="prep-intro">{c.prepIntro}</p>
        <ul>
          {c.prep.map((item) => <li>{item}</li>)}
        </ul>
        <p class="prep-trust">{c.trust}</p>
      </aside>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-head">
        <h2><span class="faq-title-hl">{c.faqTitle}</span></h2>
      </div>
      <div class="faq-list">
        {c.faq.map((f) => (
          <details>
            <summary><span>{f[0]}</span><span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{f[1]}</p>
            {f[2] && <p class="faq-action"><a href={f[2]} rel="noopener">{c.ctaStart} →</a></p>}
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.page-head{background:var(--cream);padding:64px 0 48px;border-bottom:1px solid var(--line)}
.page-head .lede{font-size:1.15rem;color:var(--ink-soft);margin-top:18px}
.steps{padding:64px 0}
.steps-title{margin-bottom:32px}
.steps-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:start}
.timeline{position:relative}
.timeline::before{content:"";position:absolute;left:21px;top:14px;bottom:70px;width:2px;background:var(--teal-100);z-index:0}
.tl-step{position:relative;border-bottom:1px solid rgba(15,107,102,.16)}
.tl-step:first-child{border-top:1px solid rgba(15,107,102,.16)}
.tl-step summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:16px;padding:16px 40px 16px 0;min-height:44px;position:relative}
.tl-step summary::-webkit-details-marker{display:none}
.tl-node{flex:none;position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--teal-700);color:#fff;font-family:var(--font-display);font-weight:700;font-size:1.05rem;box-shadow:0 0 0 4px var(--bg)}
.tl-step[open] .tl-node{background:var(--orange-500);color:#2B1503}
.tl-title{font-family:var(--font-display);font-weight:600;font-size:1.12rem;color:var(--teal-700)}
.tl-step summary .faq-icon{right:2px}
.tl-body{padding:0 0 18px 60px}
.tl-body p{color:var(--ink-soft)}
/* Above the timeline's line, on the section's own background: the line ends where the steps do, whatever the block's height. */
.steps-ctas{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:12px;padding-top:26px;background:var(--bg)}
.steps-note{flex-basis:100%;color:var(--ink-soft);font-size:.95rem}
.prep-box{margin-top:44px;max-width:68ch;background:var(--cream);border:1px solid #EFE4D2;border-radius:var(--radius-lg);padding:28px 30px}
.prep-intro{color:var(--ink-soft);margin:6px 0 12px}
.prep-box ul{padding-left:22px;display:grid;gap:8px}
.prep-trust{margin-top:18px;padding-top:16px;border-top:1px solid #EFE4D2;color:var(--teal-900);font-weight:600}
details .faq-action{opacity:1;margin-top:-8px}
.faq-action a{font-weight:600;color:var(--teal-700)}
.steps-photo{position:sticky;top:100px}
.steps-photo img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--radius-lg);box-shadow:0 16px 40px rgba(11,68,65,.16)}
.faq{background:linear-gradient(110deg,var(--sage),var(--peach));border-top:1px solid #EFE4D2;padding:72px 0}
.faq-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;align-items:start}
.faq-head{position:sticky;top:100px}
.faq-title-hl{display:inline;background:var(--orange-500);color:#fff;padding:4px 14px;box-decoration-break:clone;-webkit-box-decoration-break:clone;line-height:1.6}
.faq-head h2::after{display:none}
.faq-list{display:grid}
details{border-bottom:1px solid rgba(15,107,102,.28)}
details:first-child{border-top:1px solid rgba(15,107,102,.28)}
summary{cursor:pointer;font-weight:600;color:var(--teal-700);padding:18px 40px 18px 2px;min-height:44px;position:relative;list-style:none;display:block}
summary::-webkit-details-marker{display:none}
summary:hover{color:var(--teal-900)}
.faq-icon{position:absolute;right:4px;top:50%;width:18px;height:18px;transform:translateY(-50%)}
.faq-icon::before,.faq-icon::after{content:"";position:absolute;background:var(--teal-700);border-radius:2px}
.faq-icon::before{left:0;top:8px;width:18px;height:2px}
.faq-icon::after{left:8px;top:0;width:2px;height:18px;transition:opacity .15s ease}
details[open] .faq-icon::after{opacity:0}
details p{padding:0 40px 20px 2px;color:var(--teal-900);opacity:.85}

/* Responsive: collapse two-column layouts on tablet/mobile (placed last so it wins) */
@media (max-width:960px){
  .steps-grid{grid-template-columns:1fr;gap:32px}
  .steps-photo{position:static;order:-1}
  .faq-grid{grid-template-columns:1fr;gap:24px}
  .faq-head{position:static}
  .prep-box{padding:24px 20px}
}
</style>
