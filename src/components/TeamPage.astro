---
import Layout from '../layouts/Layout.astro';
import { type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

// Photos served locally from /public/images/.

const leaders = [
  {
    name: 'Joni Fonda',
    photo: '/images/team/joni-fonda.jpg',
    alt: { en: 'Joni Fonda, Founder of PUPA Center', id: 'Joni Fonda, Pendiri PUPA Center', ko: 'PUPA 센터 설립자 Joni Fonda' },
    role: { en: 'Founder', id: 'Pendiri', ko: '설립자' },
    bio: {
      en: 'With a deep commitment to empowering neurodivergent individuals, Joni founded PUPA Center to create a space where life skills, independence, and dignity come first. Guided by hands-on experience and a strong belief in inclusive growth, Joni continues to shape PUPA Center\u2019s vision and direction.',
      id: 'Dengan komitmen yang kuat dalam memberdayakan individu neurodivergen, Joni Fonda membangun PUPA Center sebagai ruang kolaboratif yang mengedepankan keterampilan hidup, kemandirian, dan kesiapan kerja dengan martabat sebagai fondasi utama. Berangkat dari pengalaman langsung dan keyakinan akan pertumbuhan yang inklusif, Joni Fonda terus mengarahkan visi serta langkah PUPA Center hingga hari ini.',
      ko: '신경다양인의 역량을 키우는 일에 대한 깊은 헌신으로, Joni는 생활 기술과 자립, 존엄이 최우선이 되는 공간을 만들고자 PUPA 센터를 설립했습니다. 현장의 경험과 포용적 성장에 대한 굳은 믿음을 바탕으로, 그는 지금도 PUPA 센터의 비전과 방향을 이끌어 가고 있습니다.',
    },
  },
  {
    name: 'Ninik Kristyaningsih',
    photo: '/images/team/ninik-kristyaningsih.jpg',
    alt: { en: 'Ninik Kristyaningsih, Head of Program', id: 'Ninik Kristyaningsih, Kepala Program', ko: '프로그램 총괄 Ninik Kristyaningsih' },
    role: { en: 'Head of Program', id: 'Kepala Program', ko: '프로그램 총괄' },
    bio: {
      en: 'As Head of Program, Ninik leads the development, coordination, and continuous improvement of PUPA Center\u2019s core programs. She ensures that every activity is purposeful, well-structured, and tailored to the individual needs of neurodivergent participants.',
      id: 'Sebagai Kepala Program, Ninik memimpin pengembangan, koordinasi, dan penyempurnaan berkelanjutan program-program inti PUPA Center. Ia memastikan setiap kegiatan bermakna, terstruktur dengan baik, dan disesuaikan dengan kebutuhan individual peserta neurodivergen.',
      ko: '프로그램 총괄로서 Ninik은 PUPA 센터 핵심 프로그램의 개발과 조율, 지속적인 개선을 이끕니다. 모든 활동이 목적을 갖추고 체계적으로 짜이며, 신경다양성 참여자 개개인의 필요에 맞도록 살핍니다.',
    },
  },
  {
    name: 'Adlina Attahiroh',
    photo: '/images/team/adlina-attahiroh.jpg',
    alt: { en: 'Adlina Attahiroh, Principal', id: 'Adlina Attahiroh, Kepala Sekolah', ko: '교장 Adlina Attahiroh' },
    role: { en: 'Principal', id: 'Kepala Sekolah', ko: '교장' },
    bio: {
      en: 'As Principal of PUPA Center, Adlina leads the educational vision and day-to-day implementation of the center\u2019s programs. She works alongside the team to create meaningful learning experiences that nurture independence, build practical life skills, and support each neurodivergent individual in reaching their fullest potential.',
      id: 'Sebagai Kepala Sekolah PUPA Center, Adlina memimpin visi pendidikan sekaligus pelaksanaan program-program pusat sehari-hari. Ia bekerja bersama tim untuk menciptakan pengalaman belajar yang bermakna, yang menumbuhkan kemandirian, membangun keterampilan hidup praktis, dan mendukung setiap individu neurodivergen dalam meraih potensi terbaiknya.',
      ko: 'PUPA 센터의 교장으로서 Adlina는 교육의 비전과 프로그램의 일상적 운영을 이끕니다. 팀과 함께 의미 있는 배움의 경험을 만들어, 자립을 키우고 실용적인 생활 기술을 다지며, 신경다양인 한 사람 한 사람이 자신의 잠재력을 온전히 펼치도록 돕습니다.',
    },
  },
  {
    name: 'Margaretha Tanumijaya',
    photo: '/images/team/margaretha-tanumijaya.jpg',
    alt: { en: 'Margaretha Tanumijaya, General Affairs', id: 'Margaretha Tanumijaya, General Affairs', ko: '총무 Margaretha Tanumijaya' },
    role: { en: 'General Affairs', id: 'Manajemen Operasional', ko: '총무' },
    bio: {
      en: 'Managing PUPA Center\u2019s administrative and operational functions, Margaretha ensures that the organization runs smoothly each day. She oversees internal systems, facilities, and administrative processes, creating an efficient and supportive environment for both the team and program activities.',
      id: 'Mengelola fungsi administratif dan operasional PUPA Center, Margaretha memastikan organisasi berjalan lancar setiap hari. Ia mengawasi sistem internal, fasilitas, dan proses administratif, menciptakan lingkungan yang efisien dan suportif bagi tim maupun kegiatan program.',
      ko: 'PUPA 센터의 행정과 운영을 맡은 Margaretha는 조직이 매일 순조롭게 돌아가도록 지켜 줍니다. 내부 시스템과 시설, 행정 절차를 관리하며 팀과 프로그램 활동 모두에 효율적이고 지지적인 환경을 만듭니다.',
    },
  },
  {
    name: 'Jhonson Gultom',
    photo: '/images/team/jhonson-gultom.jpg',
    alt: { en: 'Jhonson Gultom, Partnerships & Outreach', id: 'Jhonson Gultom, Kemitraan & Jangkauan', ko: '파트너십·대외 협력 Jhonson Gultom' },
    role: { en: 'Partnerships & Outreach', id: 'Kemitraan & Jangkauan', ko: '파트너십·대외 협력' },
    bio: {
      en: 'Building bridges between PUPA Center and the wider community, Jojo leads partnership development and community outreach initiatives that expand opportunities for neurodivergent individuals. He cultivates meaningful relationships with organizations, families, and partners who share PUPA Center\u2019s vision of inclusion and empowerment.',
      id: 'Membangun jembatan antara PUPA Center dan masyarakat luas, Jojo memimpin inisiatif pengembangan kemitraan dan jangkauan komunitas yang memperluas peluang bagi individu neurodivergen. Ia menjalin hubungan yang bermakna dengan organisasi, keluarga, dan mitra yang berbagi visi PUPA Center tentang inklusi dan pemberdayaan.',
      ko: 'PUPA 센터와 더 넓은 지역사회를 잇는 다리를 놓는 Jojo는 신경다양인의 기회를 넓히는 파트너십 개발과 지역사회 활동을 이끕니다. 포용과 임파워먼트라는 PUPA 센터의 비전을 함께 나누는 기관과 가족, 파트너들과 의미 있는 관계를 가꾸어 갑니다.',
    },
  },
];

const content = {
  en: {
    metaTitle: 'Our Team — The People Behind PUPA Center',
    metaDescription: 'Meet the leaders and team of PUPA Center: educators, mentors, and professionals supporting neurodivergent young adults in Tangerang, Indonesia.',
    h1: 'Our Team',
    intro: 'PUPA Center is home to a vibrant, diverse group of thinkers and doers — educators, mentors, and professionals who share one commitment: supporting neurodivergent young adults to grow in their own time and in their own way.',
    leadersTitle: 'Meet the Leaders',
    teamTitle: 'The PUPA Team',
    photoNote: 'Team photos are temporarily loaded from the current website and will be moved to the new site before launch.',
  },
  id: {
    metaTitle: 'Tim Kami — Orang-Orang di Balik PUPA Center',
    metaDescription: 'Kenali para pemimpin dan tim PUPA Center: pendidik, mentor, dan tenaga profesional yang mendampingi anak muda neurodivergen di Tangerang, Indonesia.',
    h1: 'Tim Kami',
    intro: 'PUPA Center adalah rumah bagi kelompok pemikir dan pelaku yang beragam — pendidik, mentor, dan tenaga profesional yang berbagi satu komitmen: mendampingi anak muda neurodivergen untuk bertumbuh dengan waktu dan caranya masing-masing.',
    leadersTitle: 'Kenali Para Pemimpin',
    teamTitle: 'Tim PUPA',
    photoNote: 'Foto tim sementara dimuat dari situs saat ini dan akan dipindahkan ke situs baru sebelum peluncuran.',
  },
  ko: {
    metaTitle: '팀 소개 — PUPA 센터를 만드는 사람들',
    metaDescription: 'PUPA 센터의 리더와 팀을 만나 보세요: 인도네시아 탕에랑에서 신경다양성 청년을 지원하는 교육자, 멘토, 전문가들입니다.',
    h1: '팀 소개',
    intro: 'PUPA 센터는 생각하고 실천하는 다양한 사람들의 집입니다 — 교육자, 멘토, 전문가들이 하나의 약속을 공유합니다: 신경다양성 청년이 저마다의 시간과 방식으로 성장하도록 함께하는 것.',
    leadersTitle: '리더 소개',
    teamTitle: 'PUPA 팀',
    photoNote: '팀 사진은 현재 웹사이트에서 임시로 불러온 것으로, 출시 전에 새 사이트로 옮겨질 예정입니다.',
  },
};
const c = content[lang] ?? content.en;

// Leaders grid is 3-up (6 tracks, cards span 2). Centre a short final row.
const leadRem = leaders.length % 3;
const leadOffsetIdx = leadRem === 0 ? -1 : leaders.length - leadRem;
const leadOffsetCls = leadRem === 2 ? 'offset-1' : leadRem === 1 ? 'offset-2' : '';

const team = [
  { name: 'Aini Rosadi', img: '/images/team/timothea-indirakristi.jpg' },
  { name: 'Saskya Aryanti Rahmatika', img: '/images/team/saskya-aryanti-rahmatika.jpg' },
  { name: 'Timothea Indirakristi Aditaputri', img: '/images/team/aini-rosadi.jpg' },
  { name: 'Ardhana Hariwidagdo', img: '/images/team/ardhana-hariwidagdo.jpg' },
  { name: 'Dewinta Pitaloka', img: '/images/team/dewinta-pitaloka.jpg' },
  { name: 'Earl Dimara', img: '/images/team/earl-dimara.jpg' },
  { name: 'Erani Sagala', img: '/images/team/selvi-royna-ginting.jpg' },
  { name: 'Hansen Sebastian', img: '/images/team/hansen-sebastian.jpg' },
  { name: 'Ita Oktaviani Surya', img: '/images/team/ita-oktaviani-surya.jpg' },
  { name: 'Muhammad Eraya Satriana', img: '/images/team/muhammad-eraya.jpg' },
  { name: 'Owen Albie Saputra', img: '/images/team/owen-albie-saputra.jpg' },
  { name: 'Renny Dwi Aprianti', img: '/images/team/wildan-nurkhakim.jpg' },
  { name: 'Selvi Royna Ginting', img: '/images/team/erani-sagala.jpg' },
  { name: 'Siti Rahmania', img: '/images/team/siti-rahmania.jpg' },
  { name: 'Wildan Nurkhakim', img: '/images/team/renny-dwi-aprianti.jpg' },
];
---
<Layout lang={lang} routeKey="team" title={c.metaTitle} description={c.metaDescription}>
  <section class="page-head">
    <div class="wrap">
      <h1>{c.h1}</h1>
      <p class="lede">{c.intro}</p>
    </div>
  </section>

  <section class="leaders">
    <div class="wrap">
      <h2>{c.leadersTitle}</h2>
      <div class="leader-grid">
        {leaders.map((l, i) => (
          <article class:list={['leader-card', i === leadOffsetIdx && leadOffsetCls]}>
            <img src={l.photo} alt={l.alt[lang] ?? l.alt.en} loading="lazy" width="360" height="440"
                 onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" />
            <div class="leader-info">
              <p class="leader-role">{l.role[lang] ?? l.role.en}</p>
              <h3>{l.name}</h3>
              {(l.bio[lang] ?? l.bio.en) && <p class="leader-bio">{l.bio[lang] ?? l.bio.en}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="team-sec">
    <div class="wrap">
      <h2>{c.teamTitle}</h2>
      <ul class="team-grid">
        {team.map((t) => (
          <li class="member">
            <img src={t.img} alt={t.name} loading="lazy" width="280" height="340" />
            <span>{t.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
.page-head{background:var(--cream);padding:64px 0 48px;border-bottom:1px solid var(--line)}
.page-head .lede{font-size:1.15rem;color:var(--ink-soft);margin-top:18px}
.leaders{padding:64px 0}
.leader-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:24px;margin-top:28px;align-items:stretch}
.leader-card{grid-column:span 2;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;display:flex;flex-direction:column}
.leader-card.no-photo::before{content:"";display:block;aspect-ratio:360/440;background:linear-gradient(150deg,var(--sage),var(--peach))}
.leader-card img{width:100%;aspect-ratio:4/5;object-fit:cover}
.leader-info{padding:20px 22px 24px;display:flex;flex-direction:column;flex-grow:1}
.leader-role{font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--orange-500)}
.leader-info h3{margin:4px 0 10px}
.leader-bio{font-size:.97rem;color:var(--ink-soft)}
.leader-card.offset-1{grid-column:2/span 2}
.leader-card.offset-2{grid-column:3/span 2}
.photo-note{margin-top:22px;font-size:.9rem;color:var(--ink-soft)}
.team-sec{background:var(--surface);border-top:1px solid var(--line);padding:64px 0}
.team-grid{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:24px;align-items:stretch}
.member{background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;text-align:center;display:flex;flex-direction:column}
.member img{width:100%;aspect-ratio:4/5;object-fit:cover}
.member span{display:flex;align-items:center;justify-content:center;flex-grow:1;font-weight:600;font-size:.95rem;padding:12px 10px 14px}
@media (max-width:960px){.leader-grid{grid-template-columns:1fr}.leader-card,.leader-card.offset-1,.leader-card.offset-2{grid-column:auto}.team-grid{grid-template-columns:1fr 1fr}}
</style>
